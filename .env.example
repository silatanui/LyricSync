FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-key

# Set both to True/https once deployed behind HTTPS (e.g. tanuisila.dev/LyricSync)
SESSION_COOKIE_SECURE=False
PREFERRED_URL_SCHEME=http

# MySQL (managed via phpMyAdmin, e.g. XAMPP's bundled MySQL server on port 3306)
# Leave DATABASE_URL empty to auto-build a mysql+pymysql:// URI from the MYSQL_* vars below.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lyricsync_studio

# Google OAuth (Sign in with Google) - create credentials at console.cloud.google.com
# Authorized redirect URI: http://localhost:5000/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379/0

# OpenAI API credentials (leave empty or 'mock' to use deterministic mock mode)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Application upload limits
UPLOAD_MAX_AUDIO_MB=100
UPLOAD_MAX_VIDEO_MB=500
MAX_PROJECT_DURATION_SECONDS=3600

# Storage paths
DATA_ROOT=data
MEDIA_ROOT=data/media
OUTPUT_ROOT=data/outputs
TEMP_ROOT=data/temp
