FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-key

# Leave DATABASE_URL blank to use the MYSQL_* variables below.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lyricsync_studio

REDIS_URL=redis://localhost:6379/0

# OpenAI API credentials (leave empty or 'mock' to use deterministic mock mode)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TIMEOUT_SECONDS=90
OPENAI_TRANSCRIPTION_RETRIES=1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Freemium AI image credits (admin email is always unlimited)
# Signed-in users get IMAGE_DAILY_CREDITS AI images per UTC day.
IMAGE_DAILY_CREDITS=2
IMAGE_FREE_CREDITS=2
IMAGE_PREMIUM_CREDITS=100
IMAGE_PREMIUM_PRICE_CENTS=500
IMAGE_PREMIUM_PRICE_LABEL=$5/100

# Stripe card payments (optional — leave blank until ready)
# 1) Create a Product + Price in Stripe Dashboard ($5 for 100 AI images)
# 2) Put keys below, set webhook to /api/billing/webhook/stripe for
#    checkout.session.completed and invoice.paid
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Application upload limits
UPLOAD_MAX_AUDIO_MB=100
UPLOAD_MAX_VIDEO_MB=500
MAX_PROJECT_DURATION_SECONDS=3600

# Storage paths
DATA_ROOT=data
MEDIA_ROOT=data/media
OUTPUT_ROOT=data/outputs
TEMP_ROOT=data/temp
